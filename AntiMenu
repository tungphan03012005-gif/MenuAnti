-- 6. Anti Sit (Smart Anti-Sit với On/Off)
local function isNearRealSeat(hrp)
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Seat") or obj:IsA("VehicleSeat") then
			if (obj.Position - hrp.Position).Magnitude <= 4.5 then
				return true
			end
		end
	end
	return false
end

CreateToggle("Anti Sit", function(state)
	AntiSitEnabled = state
	if state then
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "Smart Anti-Sit",
			Text = "Đã bật: Chống ngồi bệt khi không có ghế!",
			Duration = 3
		})
		
		if antiSitConnection then
			antiSitConnection:Disconnect()
		end

		antiSitConnection = RunService.RenderStepped:Connect(function()
			if not AntiSitEnabled then return end
			local character = LocalPlayer.Character
			if not character then return end
			
			local hrp = character:FindFirstChild("HumanoidRootPart")
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			
			if hrp and humanoid and humanoid.Health > 0 then
				if humanoid.Sit or humanoid:GetState() == Enum.HumanoidStateType.Sitting then
					if not isNearRealSeat(hrp) then
						humanoid.Sit = false
						humanoid:ChangeState(Enum.HumanoidStateType.Running)
						hrp.CFrame = hrp.CFrame + Vector3.new(0, 1, 0)
					end
				end
			end
		end)
	else
		if antiSitConnection then
			antiSitConnection:Disconnect()
			antiSitConnection = nil
		end
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "Smart Anti-Sit",
			Text = "Đã tắt chức năng Anti-Sit.",
			Duration = 2
		})
	end
end)

