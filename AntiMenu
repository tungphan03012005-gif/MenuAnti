CreateToggle("Tắt Fall Damage", function(state)
	FallDamageEnabled = state
	if state then
		local success, err = pcall(function()
			local RemoteConfigClient = require(game:GetService("ReplicatedStorage").ClientSystems.RemoteConfigClient.RemoteConfigClient)
			local config = RemoteConfigClient.Get(true)
			if config and config.Shared and config.Shared.DamageConfig then
				config.Shared.DamageConfig.FallDamageMinDistance = math.huge
				config.Shared.DamageConfig.FallDamageMinSpeed = math.huge
				config.Shared.DamageConfig.FallDamageMaxSpeed = math.huge
				config.Shared.DamageConfig.FallDamageRagdollThreshold = math.huge
			end
		end)
		if not success then
			warn("Fall Damage error:", err)
		end
	end
end)

